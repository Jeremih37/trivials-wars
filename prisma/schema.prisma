// Trivials Wars — Schema v2 (auth + stats + frames + icons)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique // null para invitados
  name         String   @default("Jugador")
  provider     String   @default("guest") // guest | google
  googleId     String?  @unique
  avatarBase   String   @default("warrior") // warrior | mage | archer | ...
  skinTone     String   @default("#f4c2a1")
  profileIcon  String   @default("🧠") // emoji icon
  equippedFrame String  @default("frame_basic")
  xp           Int      @default(0)
  level        Int      @default(1)
  coins        Int      @default(0)
  boxes        Int      @default(2)
  // Stats de juego
  wins         Int      @default(0)
  losses       Int      @default(0)
  currentStreak Int     @default(0) // racha actual de victorias consecutivas
  maxStreak    Int      @default(0) // mejor racha histórica
  gamesPlayed  Int      @default(0)
  // Stats específicas del modo Supervivencia (GDD: sistema de récord personal)
  survivalBestCorrect Int @default(0) // mejor cantidad de aciertos en una run
  survivalBestXp      Int @default(0) // mejor XP en una run
  survivalRuns        Int @default(0) // total de runs jugadas
  // Stats específicas del modo Muerte Súbita (GDD V3.0: Sudden Death)
  suddenDeathBestCorrect Int @default(0) // mejor racha de aciertos consecutivos
  suddenDeathBestXp      Int @default(0) // mejor XP en una run
  suddenDeathRuns        Int @default(0) // total de runs jugadas
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress     UserProgress[]
  inventory    InventoryItem[]
  sessions     GameSession[]
  unboxed      LootBoxLog[]
  equipped     EquippedItem[]
  unlocks      UserUnlock[]
}

model EquippedItem {
  id        String  @id @default(cuid())
  userId    String
  slot      String  // hat | top | aura
  itemId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, slot])
}

model UserProgress {
  id           String   @id @default(cuid())
  userId       String
  category     String
  difficulty   String
  correct      Int      @default(0)
  total        Int      @default(0)
  bestStreak   Int      @default(0)
  lastPlayedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, category, difficulty])
}

model Question {
  id              String   @id @default(cuid())
  uuid            String   @unique
  category        String
  question        String
  options         String
  correctAnswer   String
  difficulty      String
  explanation     String?  // Explicación opcional del dato (Aquatic Ambience GDD)
  createdAt       DateTime @default(now())
}

model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  type      String
  rarity    String
  acquiredAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, itemId])
}

model GameSession {
  id           String   @id @default(cuid())
  userId       String
  category     String
  difficulty   String
  totalQuestions Int
  correctCount Int
  xpEarned     Int
  bestStreak   Int
  result       String   @default("pending") // win | loss | pending
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LootBoxLog {
  id        String   @id @default(cuid())
  userId    String
  rarity    String
  itemId    String
  isDuplicate Boolean @default(false)
  xpBonus   Int      @default(0)
  openedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Desbloqueos de marcos e iconos (unificado)
model UserUnlock {
  id        String   @id @default(cuid())
  userId    String
  type      String   // frame | icon
  key       String   // id del frame o del icono
  unlockedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type, key])
}
