# ─────────────────────────────────────────────
# Trivials Wars — Variables de entorno
# ─────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# En Vercel, añade estas mismas variables en Project Settings → Environment Variables.

# ── Base de datos PostgreSQL (OBLIGATORIO en Vercel — SQLite NO funciona) ──
# Vercel Postgres: te las da automáticamente al conectar la DB al proyecto
# Neon:            copia pooled connection aquí
# Supabase:        copia la connection string aquí
DATABASE_URL="postgresql://user:password@host:5432/db?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/db"

# ── Auth (mock / dev) ──
# Cualquier string aleatorio largo. Genera uno con:  openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secret-aleatorio-de-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (OPCIONAL — si no lo configuras, el botón Google usa modo demo) ──
# Crea credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── App config ──
NODE_ENV="production"
